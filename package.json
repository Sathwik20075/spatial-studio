{
  "name": "spatial-sound-studio",
  "productName": "Spatial Sound Studio",
  "version": "1.0.0",
  "description": "System-wide spatial audio (binaural 3D, virtual surround, speaker widening) for any headphones, speakers, Bluetooth or home theatre output.",
  "main": "main.js",
  "author": {
    "name": "Your Name",
    "email": "you@example.com"
  },
  "homepage": "https://github.com/YOUR_USERNAME/spatial-sound-studio",
  "repository": {
    "type": "git",
    "url": "https://github.com/YOUR_USERNAME/spatial-sound-studio.git"
  },
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "release": "electron-builder --publish always"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.spatialsound.studio",
    "productName": "Spatial Sound Studio",
    "files": ["main.js", "preload.js", "src/**", "assets/**"],
    "directories": { "buildResources": "assets" },
    "win": {
      "target": ["nsis", "portable"],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": [{ "target": "dmg", "arch": ["x64", "arm64"] }],
      "category": "public.app-category.music",
      "icon": "assets/icon.png",
      "identity": null,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Spatial Sound Studio reads your virtual audio cable (BlackHole) to process system audio. It does not record your microphone."
      }
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Audio",
      "icon": "assets/icon.png"
    },
    "publish": { "provider": "github" }
  }
}
